# Cloud sync (optional). Copy to .env for local development.
# Without these, the app saves only on the device, as before.
#
# Supabase → Project Settings → API:
#   VITE_SUPABASE_URL                the project URL
#   VITE_SUPABASE_PUBLISHABLE_KEY    the publishable key (sb_publishable_...)
#
# Only the publishable key belongs here. It's public by design (it ships in
# the website's code); Row Level Security in the database protects the data.
# Never put a secret / service_role key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
