# Copy to .env (git-ignored) and fill in. Never commit real values.

# Warehouse target for the loader and dbt: duckdb (local file) or postgres
WAREHOUSE_TARGET=duckdb
DBT_TARGET=duckdb

# Postgres connection (only for the postgres target)
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Optional: weekly AI review
ANTHROPIC_API_KEY=
