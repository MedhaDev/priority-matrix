# Copy to .env (git-ignored) and fill in. Never commit real values.

# Warehouse target for the loader and dbt: duckdb (local file) or postgres (Supabase)
WAREHOUSE_TARGET=duckdb
DBT_TARGET=duckdb

# Supabase Postgres (Project Settings → Database → Connection string → Session pooler).
# Use the "pipeline" role created by supabase/migrations/001_warehouse.sql.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Optional: Phase 6 weekly AI review
ANTHROPIC_API_KEY=
